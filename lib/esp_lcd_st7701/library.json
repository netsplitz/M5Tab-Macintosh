{
    "name": "esp_lcd_st7701",
    "version": "1.1.5",
    "description": "ESP-IDF component (vendored from espressif/esp_lcd_st7701): ST7701/ST7701S MIPI-DSI & RGB LCD panel driver.",
    "license": "Apache-2.0",
    "frameworks": "arduino, espidf",
    "platforms": "espressif32",
    "build": {
        "srcDir": "src",
        "includeDir": "include",
        "srcFilter": ["+<*.c>"],
        "flags": [
            "-DESP_LCD_ST7701_VER_MAJOR=1",
            "-DESP_LCD_ST7701_VER_MINOR=1",
            "-DESP_LCD_ST7701_VER_PATCH=5"
        ]
    }
}
